{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "elinweb/aparat-player",
  "version": "2.0.5",
  "title": "Elinweb Lightweight Player for Aparat",
  "category": "embed",
  "icon": "video-alt3",
  "description": "Local poster; the Aparat video player loads only after a click.",
  "keywords": ["aparat", "video", "ویدئو"],
  "textdomain": "elinweb-lightweight-player-for-aparat",
  "attributes": {
    "url": {"type": "string", "default": ""},
    "title": {"type": "string", "default": ""},
    "posterId": {"type": "number", "default": 0},
    "posterURL": {"type": "string", "default": ""},
    "ratio": {"type": "string", "default": "16/9"},
    "aboveFold": {"type": "boolean", "default": false},
    "muted": {"type": "boolean"},
    "titleShow": {"type": "boolean"},
    "startTime": {"type": "number"},
    "recom": {"type": "string", "enum": ["default", "self"]},
    "playerType": {"type": "string", "enum": ["native", "aparat"], "default": "native"}
  },
  "supports": {"html": false, "customClassName": false},
  "editorScript": "lwpa-editor",
  "editorStyle": "file:../assets/player.css",
  "viewScript": "lwpa-player"
}
